{
  "name": "SDImageGenerator",
  "version": "1.0.0",
  "description": "使用本地 Stable Diffusion 模型生成图片的技能",
  "tags": [],
  "dependencies": [
    "diffusers",
    "torch",
    "transformers",
    "accelerate",
    "safetensors",
    "Pillow"
  ],
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "description": "图片描述提示词 (必填)",
      "required": true
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "description": "负面提示词，描述不想出现的内容 (可选)",
      "required": false
    },
    {
      "name": "model_name",
      "type": "string",
      "description": "使用的模型文件名，默认 sd-v1-5-tiny.safetensors",
      "required": false
    },
    {
      "name": "width",
      "type": "integer",
      "description": "生成图片宽度，默认 512，范围 256-1024",
      "required": false
    },
    {
      "name": "height",
      "type": "integer",
      "description": "生成图片高度，默认 512，范围 256-1024",
      "required": false
    },
    {
      "name": "steps",
      "type": "integer",
      "description": "采样步数，默认 20，范围 10-50",
      "required": false
    },
    {
      "name": "cfg_scale",
      "type": "float",
      "description": "提示词引导强度，默认 7.0，范围 1.0-20.0",
      "required": false
    },
    {
      "name": "seed",
      "type": "integer",
      "description": "随机种子，-1表示随机，默认 -1",
      "required": false
    },
    {
      "name": "output_dir",
      "type": "string",
      "description": "输出目录，默认 ./generated_images",
      "required": false
    },
    {
      "name": "batch_size",
      "type": "integer",
      "description": "一次生成数量，默认 1，范围 1-4",
      "required": false
    },
    {
      "name": "scheduler",
      "type": "string",
      "description": "采样调度器，可选 ddim, pndm, lms, euler, euler_a, dpm",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "image_paths",
      "description": "生成的图片路径列表"
    },
    {
      "name": "parameters",
      "description": "使用的生成参数"
    },
    {
      "name": "model_used",
      "description": "使用的模型名称"
    },
    {
      "name": "generation_time",
      "description": "生成耗时"
    },
    {
      "name": "generated_at",
      "description": "生成时间"
    }
  ],
  "config": {},
  "class_name": "Sdimagegenerator"
}